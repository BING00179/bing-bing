# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 절대 커밋하지 마세요.
#
#   cp .env.example .env
#   set -a && source .env && set +a

# 텔레그램 봇 토큰 — @BotFather 에게 /newbot 으로 발급받습니다.
TELEGRAM_BOT_TOKEN=

# 알림 받을 채팅 ID — 봇에게 아무 말이나 보낸 뒤 아래 주소에서 chat.id 확인
#   https://api.telegram.org/bot<토큰>/getUpdates
TELEGRAM_CHAT_ID=

# (선택) Benzinga 뉴스 API 키. 없으면 yfinance 무료 헤드라인을 씁니다.
BENZINGA_API_KEY=

# (선택) DART 오픈API 인증키 — 공시·재무 분석용. 무료입니다.
#   https://opendart.fss.or.kr → 인증키 신청/관리 → 인증키 신청
# 없어도 시세 기반 스캐너는 전부 동작합니다.
DART_API_KEY=
